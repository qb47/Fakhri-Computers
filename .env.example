# Copy this file to `.env` and fill in your own project's values.
# `.env` is git-ignored — never commit real keys.
#
# Find these in: Supabase Dashboard → Project Settings → API
#
# Both values are SAFE to expose in the browser. Your data is protected by
# row-level security, not by keeping these secret. Never put the `service_role`
# key here — that one bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
